{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.EdamamRecipeClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FoodAi": {
    "Provider": "Demo",
    "UseDemoFallback": true,
    "AzureOpenAI": {
      "Endpoint": "",
      "ApiKey": "",
      "Deployment": "",
      "ImageDetail": "high",
      "MaxOutputTokensPerImage": 4000,
      "MaxParallelImages": 2
    },
    "ScanCache": {
      "Enabled": true,
      "DurationHours": 168,
      "MaxEntries": 500
    }
  },
  "RecipeCatalog": {
    "Provider": "AzureWebSearch",
    "AzureWebSearch": {
      "MaxToolCalls": 4,
      "MaxOutputTokens": 4000,
      "CandidateCount": 5,
      "MinimumResultCount": 5,
      "BatchSize": 3,
      "MaxSearchAttempts": 2,
      "Market": "en-GB"
    },
    "Edamam": {
      "AppId": "",
      "AppKey": ""
    },
    "CommercialImages": {
      "Enabled": true,
      "AllowUnverifiedForTesting": false,
      "MaxCandidates": 8,
      "MaxResponseBytes": 2097152,
      "CacheEnabled": true,
      "CacheDurationHours": 168,
      "CacheMaxEntries": 500,
      "AllowedProviders": [
        "WikimediaCommons",
        "Pexels",
        "Pixabay"
      ]
    },
    "Cache": {
      "Enabled": false,
      "ProviderPermissionConfirmed": false,
      "DurationHours": 168,
      "MaxEntries": 500
    }
  },
  "UsageControl": {
    "Enabled": true,
    "AiEnabled": true,
    "AllowTestReset": false,
    "DailyScanLimit": 10,
    "DailyRecipeLimit": 300,
    "EstimatedScanCostUsd": 0.02,
    "EstimatedRecipeCostUsd": 0.05,
    "GlobalDailyBudgetUsd": 50.0
  },
  "PromptAdmin": {
    "Enabled": false,
    "ApiKey": "",
    "StoragePath": "App_Data/prompt-settings.json",
    "MaxPromptLength": 8000,
    "SessionHours": 8
  }
}
