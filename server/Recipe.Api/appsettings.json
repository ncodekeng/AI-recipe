{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.EdamamRecipeClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FoodAi": {
    "Provider": "Demo",
    "UseDemoFallback": true,
    "AzureOpenAI": {
      "Endpoint": "",
      "ApiKey": "",
      "Deployment": ""
    },
    "ScanCache": {
      "Enabled": true,
      "DurationHours": 168,
      "MaxEntries": 500
    }
  },
  "RecipeCatalog": {
    "Edamam": {
      "AppId": "",
      "AppKey": ""
    },
    "Cache": {
      "Enabled": false,
      "ProviderPermissionConfirmed": false,
      "DurationHours": 168,
      "MaxEntries": 500
    }
  },
  "UsageControl": {
    "Enabled": true,
    "AiEnabled": true,
    "AllowTestReset": false,
    "DailyScanLimit": 10,
    "DailyRecipeLimit": 3,
    "EstimatedScanCostUsd": 0.02,
    "EstimatedRecipeCostUsd": 0.05,
    "GlobalDailyBudgetUsd": 50.0
  }
}
